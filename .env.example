# ---------------------------------------------------------------------------
# Deadwax environment
#
# Notable property of this stack: THE CATALOGUE NEEDS NO CREDENTIAL. Deezer,
# MusicBrainz and the Cover Art Archive are all keyless, so a cold clone works
# with nothing set but AUTH_SECRET.
# ---------------------------------------------------------------------------

# Unset  => PGlite at ./.pglite (development, or one long-lived server).
# Set    => hosted Postgres over TCP, and the build-time migration runs.
# PGlite writes to the local filesystem and allows exactly ONE writer, so it
# cannot be used on serverless hosting.
#
# Getting one needs no signup and no API key:
#   npx neon@latest claim create --service postgres --file .env.local
#   npx neon@latest claim accept      # transfers it to your account; 72h otherwise
#
# Note that `npm run smoke` and `npm run seed` read this file, so setting this
# points them at the hosted database. `npm run db:local` refuses to run while it
# is set, which is the guard that keeps a "local" command off a real server.
DATABASE_URL=

# REQUIRED. Read by Auth.js itself. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Base for email links, and the contact string in the MusicBrainz User-Agent
# (their policy requires a way to reach the operator).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strict "true". Anything else — including "1" and "yes" — reads as false.
# Off by default: enforcing the gate without a verified sending domain would
# lock every new member out of posting with no self-service fix.
REQUIRE_EMAIL_VERIFICATION=false

# Absent => reset and verification mail is written to the server log and
# reported as { delivered: true, via: "log" }. Logged rather than dropped so a
# developer can complete the flow, and so a missing provider in production is
# visible in the logs instead of looking like success.
RESEND_API_KEY=
EMAIL_FROM=

# Optional. Unlocks listener counts (a better familiarity proxy than streaming
# popularity) and a second artist-similarity source. Absent => both features
# degrade to absent, never to wrong.
LASTFM_API_KEY=

# Optional. Absent => /api/cron/prune 404s rather than running unauthenticated.
CRON_SECRET=

# Optional. Honoured by db:reset, unlike the TV original which hardcodes it.
PGLITE_DATA_DIR=./.pglite
