{
  "name": "deadwax",
  "version": "0.1.0",
  "private": true,
  "description": "Deadwax \u2014 a social diary for records.",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate-deploy.ts && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:deploy": "tsx scripts/migrate-deploy.ts",
    "vercel:setup": "node scripts/vercel-setup.mjs",
    "db:local": "tsx --conditions=react-server scripts/db-local.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "seed": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/seed.ts",
    "repair:editions": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/repair-editions.ts",
    "smoke": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/smoke.ts",
    "taste-eval": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/taste-eval.ts",
    "admin:grant": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/grant-admin.ts",
    "security:probe": "tsx scripts/security-probe.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-slot": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.28.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9"
  }
}
